{
  "name": "pyrosattrack",
  "version": "0.1.0",
  "description": "SkyPhreak — clean, high-resolution sky tracker: satellites, the Moon, planets and deep-sky objects on a live 2D map and 3D globe, with pass prediction and smooth rotator/radio control.",
  "author": "Allan Snelder",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,green \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && cross-env ELECTRON_DEV=1 electron .",
    "build": "vite build",
    "fetch-textures": "node scripts/fetch-textures.mjs",
    "start": "npm run build && electron .",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.pyro.skyphreak",
    "productName": "SkyPhreak",
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SkyPhreak",
      "artifactName": "${productName}-${version}-Setup.${ext}"
    }
  },
  "dependencies": {
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "globe.gl": "^2.46.1",
    "satellite.js": "^5.0.0",
    "three": "^0.184.0",
    "topojson-client": "^3.1.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1",
    "world-atlas": "^2.0.2"
  }
}
